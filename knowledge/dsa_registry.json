  "generic_socratic_angles": {
    "ELIMINATED_RANGE_PROOF": "Ask which elements/indices are provably eliminated and why",
    "COUNTEREXAMPLE": "Provide a concrete case where the student's approach fails",
    "INVARIANT_RESTATEMENT": "Ask the student to state what must remain true at each step",
    "OPPOSITE_BRANCH_TRANSFER": "Apply the same reasoning to the opposite case",
    "EDGE_CASE": "Ask what happens in edge cases (empty, single element, boundary)",
    "COMPLEXITY_ANALYSIS": "Ask about time/space complexity and why",
    "TRACE_THROUGH": "Ask the student to trace through a concrete example step by step",
    "POINTER_TRACKING": "Ask what each pointer/variable holds at each step",
    "STATE_DEFINITION": "Ask what the DP state represents and what it stores",
    "TRANSITION_PROOF": "Ask why the transition formula is correct",
    "EXCHANGE_ARGUMENT": "Ask to prove the greedy choice doesn't decrease optimality",
    "PRUNING_ANALYSIS": "Ask why a branch can be pruned safely",
    "STABILITY_CHECK": "Ask whether sort preserves relative order of equal elements",
    "LOOP_TERMINATION": "Ask how the loop is guaranteed to terminate",
    "RECURSION_TRACE": "Ask to trace the recursion tree for a small input"
  }
